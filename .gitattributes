# Force LF everywhere. With CRLF in the working tree, Jekyll's excerpt
# separator ("\n\n") never matches, so every post's meta description silently
# became the entire post body. Windows checkouts here produce CRLF by default.
* text=auto eol=lf

# Never let git rewrite these, whatever content-detection thinks.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.webm binary
*.mp4  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.stl  binary
*.3mf  binary
